# ==============================================================================
# PayPath — PayPal Payment Reliability Lab & AI Diagnostic Engine
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PAYPAL SANDBOX CREDENTIALS (Required for live Sandbox API execution)
# ------------------------------------------------------------------------------
# Obtain from PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# Create a REST API app under your Sandbox Business account.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# PayPal Webhook ID (Optional for webhook signature verification)
# Created in Developer Dashboard -> App Settings -> Add Webhook
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# PayPal Environment ('sandbox' or 'live')
# PayPath enforces 'sandbox' mode to prevent accidental live-money charges
PAYPAL_ENV=sandbox

# ------------------------------------------------------------------------------
# 2. AI DIAGNOSTIC ENGINE (Google Gemini API)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# If left blank, PayPath seamlessly uses its built-in Deterministic Payment Rule Engine.
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection (default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
AI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
